#include <htcleo_priv.h>

EXPORT_C void __NAKED__ THtcleo::SetTimerLoad(TUint /* aTimerBase */,
                                               TUint32 /* aValue */)
    {
    asm("str r1, [r0, #%a0]" : : "i" (EGptMatch));
    asm("bx lr");
    }

EXPORT_C TUint __NAKED__ THtcleo::TimerLoad(TUint /* aTimerBase */)
    {
    asm("ldr r0, [r0, #%a0]" : : "i" (EGptMatch));
    asm("bx lr");
    }

EXPORT_C TUint __NAKED__ THtcleo::TimerValue(TUint /* aTimerBase */)
    {
    asm("ldr r0, [r0, #%a0]" : : "i" (EGptCount));
    asm("bx lr");
    }

EXPORT_C void __NAKED__ THtcleo::ClearTimerInt(TUint /* aTimerBase */)
    {
    asm("mov r1, #1");
    asm("str r1, [r0, #%a0]" : : "i" (EGptClear));
    asm("bx lr");
    }

EXPORT_C void THtcleo::EnableInt(TUint anId)
    {
    if (anId < (TUint)KNumHtcleoInts)
        {
        const TUint bankOffset = (anId >> 5) << 2;
        WriteReg(KHwBaseVic, EVicIntEnSet0 + bankOffset,
                 1u << (anId & 31));
        QsdDrainWriteBuffer();
        }
    }

EXPORT_C void THtcleo::DisableInt(TUint anId)
    {
    if (anId < (TUint)KNumHtcleoInts)
        {
        const TUint bankOffset = (anId >> 5) << 2;
        WriteReg(KHwBaseVic, EVicIntEnClear0 + bankOffset,
                 1u << (anId & 31));
        QsdDrainWriteBuffer();
        }
    }
