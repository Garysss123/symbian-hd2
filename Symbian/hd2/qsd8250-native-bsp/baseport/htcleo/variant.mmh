#include <platform_paths.hrh>

/*
 * EKA2 has no dedicated Qualcomm Scorpion target.  QSD8250 implements the
 * ARMv7-A operations used by the proven Cortex-A8N path.  The one observed
 * cache-policy difference (CTR.L1Ip == 1) is handled by the source patch in
 * this package rather than by binary instruction replacement.
 */
macro __CPU_CORTEX_A8N__
macro __CPU_QSD8250__
macro __VFP_V3
macro __HTCLEO__
#define __BUILD_VARIANT_EUSER_AS_ARM__
macro __HTCLEO_LOW_ROM_PD_FIX_PROBE__
#define HTCLEO

#define MM_MULTIPLE

#ifndef GCCE
macro __CPU_HAS_VFP
#define USE_VFP_MATH
#endif

macro __DEBUGGER_SUPPORT__
macro FASTTRACE_KERNEL_ALL

#define VariantTarget(name,ext)     _htcleo_##name.ext
#define AsspNKernIncludePath        /sf/adapt/htcleo/baseport/htcleo/specific
#define VariantMediaDefIncludePath  /epoc32/include/htcleo
#define PlatformLib                 kahtcleo.lib

systeminclude /epoc32/include/memmodel/epoc/mmubase
systeminclude /epoc32/include/memmodel/epoc/multiple
systeminclude /epoc32/include/memmodel/epoc/multiple/arm

SYMBIAN_BASE_SYSTEMINCLUDE(memmodel/epoc/mmubase)
SYMBIAN_BASE_SYSTEMINCLUDE(memmodel/epoc/multiple)
SYMBIAN_BASE_SYSTEMINCLUDE(memmodel/epoc/multiple/arm)
OS_LAYER_SYSTEMINCLUDE

systeminclude ../../../../os/kernelhwsrv/driversupport/socassp/interface
