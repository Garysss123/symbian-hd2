#include <variant.mmh>
#include "kernel/kern_ext.mmh"

TARGET          VariantTarget(epbussdiov,dll)
TARGETTYPE      kext
LINKAS          epbussdiov.dll

SYMBIAN_BASE_SYSTEMINCLUDE(drivers)
