#include <variant.mmh>
#include "kernel/kern_ext.mmh"

TARGET			VariantTarget(kahtcleo,dll)
TARGETTYPE		var

EXPORTLIBRARY	kahtcleo
LINKAS			kahtcleo.dll

SYSTEMINCLUDE   ./specific

SOURCEPATH		./specific
SOURCE		    htcleo.cpp qsd8k_hal.cpp interrupts.cpp assp.cpp
SOURCE		    htcleo.cia interrupts.cia

// now specified in kern_ext.lib
//LIBRARY			ekern.lib

DEFFILE			./~/kahtcleo.def

NOSTRICTDEF

EPOCALLOWDLLDATA

UID				0x1000008d 0x100039e8
VENDORID        0x70000001

CAPABILITY		all
