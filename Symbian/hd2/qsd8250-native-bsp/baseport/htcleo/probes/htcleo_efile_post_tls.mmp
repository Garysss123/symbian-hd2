/* EFILE-only EKA2 startup library for the iteration-139 post-TLS probe. */

TARGET          htcleo_efile_post_tls.lib
TARGETTYPE      lib

ALWAYS_BUILD_AS_ARM
MACRO           __HTCLEO_EFILE_POST_TLS_UDF_PROBE__

SOURCEPATH      .
SOURCE          htcleo_efile_post_tls.cia

SOURCEPATH      ../../../../../os/kernelhwsrv/kernel/eka/euser/epoc/arm
SOURCE          uc_exe.cpp

USERINCLUDE     ../../../../../os/kernelhwsrv/kernel/eka/include
USERINCLUDE     ../../../../../os/kernelhwsrv/kernel/eka/euser/epoc/arm
OS_LAYER_SYSTEMINCLUDE_SYMBIAN

CAPABILITY      all
VENDORID        0x70000001
SMPSAFE
