diff --git a/kernel/eka/kernel/arm/ckernel.cpp b/kernel/eka/kernel/arm/ckernel.cpp
--- a/kernel/eka/kernel/arm/ckernel.cpp
+++ b/kernel/eka/kernel/arm/ckernel.cpp
@@ -141,6 +141,66 @@ extern "C" {
 extern SFullArmRegSet DefaultRegSet;
 }
 
+#if defined(__CPU_QSD8250__) && defined(__HTCLEO_GATE3_POST_TLS_UDF_PROBE__)
+/* Iteration 139's sole non-halting renderer, after EFILE heap/TLS setup. */
+static void HtcleoGate3PostTlsScreenProbe()
+	{
+	const TUint KWidth = 480;
+	const TUint KHeight = 800;
+	const TUint16 KDarkPurple = 0x4010;
+	const TUint16 KWhite = 0xffff;
+	const TUint16 KOrange = 0xfd20;
+	volatile TUint16* const fb = (volatile TUint16*)0xc6400000u;
+
+	for (TUint y = 0; y < KHeight; ++y)
+		{
+		for (TUint x = 0; x < KWidth; ++x)
+			{
+			TUint16 colour = KDarkPurple;
+			if (x < 8 || x >= KWidth - 8 || y < 8 || y >= KHeight - 8)
+				colour = KWhite;
+			/* A large block T for the post-TLS checkpoint. */
+			const TBool top = y >= 240 && y < 272 && x >= 144 && x < 336;
+			const TBool stem = x >= 224 && x < 256 && y >= 240 && y < 560;
+			if (top || stem)
+				colour = KOrange;
+			fb[y * KWidth + x] = colour;
+			}
+		}
+	__e32_io_completion_barrier();
+	}
+
+static TBool HtcleoHandleGate3PostTlsUdf(TArmExcInfo* aContext, TInt aMode)
+	{
+	if (aMode != EUserMode ||
+		aContext->iExcCode != EArmExceptionUndefinedOpcode ||
+		(aContext->iCpsr & ECpuThumb))
+		return EFalse;
+
+	GetUndefinedInstruction(aContext);
+	if (aContext->iFaultAddress != 0xe7f000f0u)
+		return EFalse;
+
+	TArmExcInfo next = *aContext;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0xe3540005u) /* cmp r4,#5 */
+		return EFalse;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0xea000000u) /* b over unique-ID word */
+		return EFalse;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0x48313339u) /* ASCII H139 */
+		return EFalse;
+
+	HtcleoGate3PostTlsScreenProbe();
+	aContext->iR15 += 4; /* Resume at the untouched CMP after the ARM UDF. */
+	return ETrue;
+	}
+#endif
+
 #ifdef __CPU_HAS_VFP
 GLREF_C TInt HandleVFPOperation(TAny* aPtr);
 #endif
