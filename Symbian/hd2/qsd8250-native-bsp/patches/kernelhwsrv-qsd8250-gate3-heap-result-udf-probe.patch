+#if defined(__CPU_QSD8250__) && defined(__HTCLEO_GATE3_HEAP_RESULT_UDF_PROBE__)
+/* Iteration 141's sole renderer: SetupThreadHeap return-code display. */
+static void HtcleoGate3HeapResultScreenProbe(TInt aResult)
+	{
+	const TUint KWidth = 480;
+	const TUint KHeight = 800;
+	const TUint16 KWhite = 0xffff;
+	const TUint16 KYellow = 0xffe0;
+	const TUint16 KBackground = aResult == KErrNone ? 0x0200 : 0x4000;
+	volatile TUint16* const fb = (volatile TUint16*)0xc6400000u;
+	TUint digit = aResult < 0 ? (TUint)(-aResult) : (TUint)aResult;
+	TUint segments;
+	switch (digit)
+		{
+		case 0: segments = 0x3f; break;
+		case 1: segments = 0x06; break;
+		case 2: segments = 0x5b; break;
+		case 3: segments = 0x4f; break;
+		case 4: segments = 0x66; break;
+		case 5: segments = 0x6d; break;
+		case 6: segments = 0x7d; break;
+		case 7: segments = 0x07; break;
+		case 8: segments = 0x7f; break;
+		case 9: segments = 0x6f; break;
+		default: segments = 0x79; break; /* E */
+		}
+
+	for (TUint y = 0; y < KHeight; ++y)
+		{
+		for (TUint x = 0; x < KWidth; ++x)
+			{
+			TUint16 colour = KBackground;
+			if (x < 8 || x >= KWidth - 8 || y < 8 || y >= KHeight - 8)
+				colour = KWhite;
+			const TBool a = (segments & 0x01) && y >= 220 && y < 248 && x >= 160 && x < 320;
+			const TBool b = (segments & 0x02) && x >= 292 && x < 320 && y >= 220 && y < 384;
+			const TBool c = (segments & 0x04) && x >= 292 && x < 320 && y >= 384 && y < 548;
+			const TBool d = (segments & 0x08) && y >= 520 && y < 548 && x >= 160 && x < 320;
+			const TBool e = (segments & 0x10) && x >= 160 && x < 188 && y >= 384 && y < 548;
+			const TBool f = (segments & 0x20) && x >= 160 && x < 188 && y >= 220 && y < 384;
+			const TBool g = (segments & 0x40) && y >= 370 && y < 398 && x >= 160 && x < 320;
+			if (a || b || c || d || e || f || g)
+				colour = KYellow;
+			fb[y * KWidth + x] = colour;
+			}
+		}
+	__e32_io_completion_barrier();
+	}
+
+static TBool HtcleoHandleGate3HeapResultUdf(TArmExcInfo* aContext, TInt aMode)
+	{
+	if (aMode != EUserMode ||
+		aContext->iExcCode != EArmExceptionUndefinedOpcode ||
+		(aContext->iCpsr & ECpuThumb))
+		return EFalse;
+
+	GetUndefinedInstruction(aContext);
+	if (aContext->iFaultAddress != 0xe7f000f0u)
+		return EFalse;
+
+	TArmExcInfo next = *aContext;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0xe3540007u) /* cmp r4,#7 */
+		return EFalse;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0xea000000u) /* b over unique-ID word */
+		return EFalse;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0x48313431u) /* ASCII H141 */
+		return EFalse;
+
+	HtcleoGate3HeapResultScreenProbe((TInt)aContext->iR6);
+	aContext->iR15 += 4; /* Resume at the untouched CMP after the ARM UDF. */
+	return ETrue;
+	}
+#endif
