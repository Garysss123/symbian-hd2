diff --git a/kernel/eka/kernel/sexec.cpp b/kernel/eka/kernel/sexec.cpp
--- a/kernel/eka/kernel/sexec.cpp
+++ b/kernel/eka/kernel/sexec.cpp
@@ -820,6 +820,41 @@ TInt ExecHandler::LastThreadHandle()
 	return r;
 	}
 
+#if defined(__CPU_QSD8250__) && defined(__HTCLEO_GATE3_CHUNK_CREATE_ENTRY_SCREEN_PROBE__)
+/* Iteration 146: stop at the EFILE 16 MiB heap ChunkCreate kernel entry. */
+static void HtcleoGate3ChunkCreateEntryScreenProbe()
+	{
+	const TUint KWidth = 480;
+	const TUint KHeight = 800;
+	const TUint16 KBackground = 0x0010;
+	const TUint16 KWhite = 0xffff;
+	const TUint16 KOrange = 0xfd20;
+	volatile TUint16* const fb = (volatile TUint16*)0xc6400000u;
+	for (TUint y = 0; y < KHeight; ++y)
+		{
+		for (TUint x = 0; x < KWidth; ++x)
+			{
+			TUint16 colour = KBackground;
+			if (x < 8 || x >= KWidth - 8 || y < 8 || y >= KHeight - 8)
+				colour = KWhite;
+			/* Seven-segment digit 6. */
+			const TBool a = y >= 220 && y < 248 && x >= 160 && x < 320;
+			const TBool c = x >= 292 && x < 320 && y >= 384 && y < 548;
+			const TBool d = y >= 520 && y < 548 && x >= 160 && x < 320;
+			const TBool e = x >= 160 && x < 188 && y >= 384 && y < 548;
+			const TBool f = x >= 160 && x < 188 && y >= 220 && y < 384;
+			const TBool g = y >= 370 && y < 398 && x >= 160 && x < 320;
+			if (a || c || d || e || f || g)
+				colour = KOrange;
+			fb[y * KWidth + x] = colour;
+			}
+		}
+	__e32_io_completion_barrier();
+	for (;;)
+		__e32_io_completion_barrier();
+	}
+#endif
+
 TInt ExecHandler::ChunkCreate(TOwnerType aType, const TDesC8* aName, TChunkCreate& anInfo)
 	{
 	TKName n;
@@ -829,6 +864,14 @@ TInt ExecHandler::ChunkCreate(TOwnerType aType, const TDesC8* aName, TChunkCreat
 	TChunkCreate uinfo;
 	SChunkCreateInfo info;
 	kumemget32(&uinfo,&anInfo,sizeof(uinfo));
+#if defined(__CPU_QSD8250__) && defined(__HTCLEO_GATE3_CHUNK_CREATE_ENTRY_SCREEN_PROBE__)
+	/* EFILE's initial hybrid heap: 2 * 8 MiB, disconnected and uncommitted. */
+	if (uinfo.iMaxSize == 0x01000000 &&
+		uinfo.iInitialBottom == 0 &&
+		uinfo.iInitialTop == 0)
+		HtcleoGate3ChunkCreateEntryScreenProbe();
+#endif
+
 	info.iGlobal=uinfo.iAtt & TChunkCreate::EGlobal;
 	info.iAtt = uinfo.iAtt&TChunkCreate::EChunkCreateAttMask;
 	info.iForceFixed=uinfo.iForceFixed;
