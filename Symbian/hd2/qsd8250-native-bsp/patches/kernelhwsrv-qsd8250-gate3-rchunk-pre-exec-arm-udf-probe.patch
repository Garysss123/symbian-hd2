+#if defined(__CPU_QSD8250__) && defined(__HTCLEO_GATE3_RCHUNK_PRE_EXEC_ARM_UDF_PROBE__)
+/* Iteration 147: qualified ARM UDF immediately before Exec::ChunkCreate. */
+static void HtcleoGate3RChunkPreExecScreenProbe()
+	{
+	const TUint KWidth = 480;
+	const TUint KHeight = 800;
+	const TUint16 KBackground = 0x0410;
+	const TUint16 KWhite = 0xffff;
+	const TUint16 KYellow = 0xffe0;
+	volatile TUint16* const fb = (volatile TUint16*)0xc6400000u;
+	for (TUint y = 0; y < KHeight; ++y)
+		{
+		for (TUint x = 0; x < KWidth; ++x)
+			{
+			TUint16 colour = KBackground;
+			if (x < 8 || x >= KWidth - 8 || y < 8 || y >= KHeight - 8)
+				colour = KWhite;
+			/* Seven-segment digit 7. */
+			const TBool a = y >= 220 && y < 248 && x >= 160 && x < 320;
+			const TBool b = x >= 292 && x < 320 && y >= 220 && y < 384;
+			const TBool c = x >= 292 && x < 320 && y >= 384 && y < 548;
+			if (a || b || c)
+				colour = KYellow;
+			fb[y * KWidth + x] = colour;
+			}
+		}
+	__e32_io_completion_barrier();
+	for (;;)
+		__e32_io_completion_barrier();
+	}
+
+static TBool HtcleoHandleGate3RChunkPreExecArmUdf(TArmExcInfo* aContext, TInt aMode)
+	{
+	if (aMode != EUserMode ||
+		aContext->iExcCode != EArmExceptionUndefinedOpcode ||
+		(aContext->iCpsr & ECpuThumb))
+		return EFalse;
+
+	GetUndefinedInstruction(aContext);
+	if (aContext->iFaultAddress != 0xe7f000f0u)
+		return EFalse;
+
+	TArmExcInfo next = *aContext;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0xe354000du)
+		return EFalse;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0xea000000u)
+		return EFalse;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0x48313437u) /* ASCII H147 */
+		return EFalse;
+	if (aContext->iR6 != 0x01000000u)
+		return EFalse;
+
+	HtcleoGate3RChunkPreExecScreenProbe();
+	return ETrue;
+	}
+#endif
