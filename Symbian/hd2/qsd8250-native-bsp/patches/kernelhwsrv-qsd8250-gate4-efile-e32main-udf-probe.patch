--- a/kernel/eka/kernel/arm/ckernel.cpp
+++ b/kernel/eka/kernel/arm/ckernel.cpp
@@ -141,6 +141,67 @@ extern "C" {
 extern SFullArmRegSet DefaultRegSet;
 }
 
+#if defined(__CPU_QSD8250__) && defined(__HTCLEO_GATE4_UDF_PROBE__)
+/* Iteration 138's sole non-halting renderer, qualified inside EFILE E32Main. */
+static void HtcleoGate4EfileE32MainScreenProbe()
+	{
+	const TUint KWidth = 480;
+	const TUint KHeight = 800;
+	const TUint16 KDarkCyan = 0x03ef;
+	const TUint16 KWhite = 0xffff;
+	const TUint16 KYellow = 0xffe0;
+	volatile TUint16* const fb = (volatile TUint16*)0xc6400000u;
+
+	for (TUint y = 0; y < KHeight; ++y)
+		{
+		for (TUint x = 0; x < KWidth; ++x)
+			{
+			TUint16 colour = KDarkCyan;
+			if (x < 8 || x >= KWidth - 8 || y < 8 || y >= KHeight - 8)
+				colour = KWhite;
+			/* A large block digit 4, centred in portrait orientation. */
+			const TBool left = x >= 144 && x < 176 && y >= 256 && y < 432;
+			const TBool middle = x >= 144 && x < 336 && y >= 400 && y < 432;
+			const TBool right = x >= 304 && x < 336 && y >= 224 && y < 576;
+			if (left || middle || right)
+				colour = KYellow;
+			fb[y * KWidth + x] = colour;
+			}
+		}
+	__e32_io_completion_barrier();
+	}
+
+static TBool HtcleoHandleGate4EfileE32MainUdf(TArmExcInfo* aContext, TInt aMode)
+	{
+	if (aMode != EUserMode ||
+		aContext->iExcCode != EArmExceptionUndefinedOpcode ||
+		!(aContext->iCpsr & ECpuThumb))
+		return EFalse;
+
+	GetUndefinedInstruction(aContext);
+	if (aContext->iFaultAddress != 0xde44u)
+		return EFalse;
+
+	TArmExcInfo next = *aContext;
+	next.iR15 += 2;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0x2c02u) /* Thumb cmp r4,#2 */
+		return EFalse;
+	next.iR15 += 2;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0xe000u) /* Thumb b over unique-ID halfword */
+		return EFalse;
+	next.iR15 += 2;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0x4834u) /* gate-4 unique ID */
+		return EFalse;
+
+	HtcleoGate4EfileE32MainScreenProbe();
+	aContext->iR15 += 2; /* Resume at the untouched CMP after the Thumb UDF. */
+	return ETrue;
+	}
+#endif
+
 #ifdef __CPU_HAS_VFP
 GLREF_C TInt HandleVFPOperation(TAny* aPtr);
 #endif
