+#if defined(__CPU_QSD8250__) && defined(__HTCLEO_GATE3_POST_HEAP_UDF_PROBE__)
+/* Iteration 140's sole non-halting renderer, after EFILE heap setup. */
+static void HtcleoGate3PostHeapScreenProbe()
+	{
+	const TUint KWidth = 480;
+	const TUint KHeight = 800;
+	const TUint16 KDarkRed = 0x4000;
+	const TUint16 KWhite = 0xffff;
+	const TUint16 KCyan = 0x07ff;
+	volatile TUint16* const fb = (volatile TUint16*)0xc6400000u;
+
+	for (TUint y = 0; y < KHeight; ++y)
+		{
+		for (TUint x = 0; x < KWidth; ++x)
+			{
+			TUint16 colour = KDarkRed;
+			if (x < 8 || x >= KWidth - 8 || y < 8 || y >= KHeight - 8)
+				colour = KWhite;
+			/* A large block H for the post-heap checkpoint. */
+			const TBool left = x >= 144 && x < 176 && y >= 240 && y < 560;
+			const TBool middle = y >= 384 && y < 416 && x >= 144 && x < 336;
+			const TBool right = x >= 304 && x < 336 && y >= 240 && y < 560;
+			if (left || middle || right)
+				colour = KCyan;
+			fb[y * KWidth + x] = colour;
+			}
+		}
+	__e32_io_completion_barrier();
+	}
+
+static TBool HtcleoHandleGate3PostHeapUdf(TArmExcInfo* aContext, TInt aMode)
+	{
+	if (aMode != EUserMode ||
+		aContext->iExcCode != EArmExceptionUndefinedOpcode ||
+		(aContext->iCpsr & ECpuThumb))
+		return EFalse;
+
+	GetUndefinedInstruction(aContext);
+	if (aContext->iFaultAddress != 0xe7f000f0u)
+		return EFalse;
+
+	TArmExcInfo next = *aContext;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0xe3540006u) /* cmp r4,#6 */
+		return EFalse;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0xea000000u) /* b over unique-ID word */
+		return EFalse;
+	next.iR15 += 4;
+	GetUndefinedInstruction(&next);
+	if (next.iFaultAddress != 0x48313430u) /* ASCII H140 */
+		return EFalse;
+
+	HtcleoGate3PostHeapScreenProbe();
+	aContext->iR15 += 4; /* Resume at the untouched CMP after the ARM UDF. */
+	return ETrue;
+	}
+#endif
